rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function validPost(p) {
      return p.keys().hasAll(['title','excerpt','body','category','coverUrl','youtubeUrl','status','authorId','createdAt','updatedAt'])
        && p.keys().hasOnly(['title','excerpt','body','category','coverUrl','youtubeUrl','status','authorId','createdAt','updatedAt'])
        && p.title is string && p.title.size() > 0 && p.title.size() <= 160
        && p.excerpt is string && p.excerpt.size() > 0 && p.excerpt.size() <= 400
        && p.body is string && p.body.size() > 0 && p.body.size() <= 80000
        && p.category is string && p.category.size() > 0 && p.category.size() <= 60
        && p.coverUrl is string && p.coverUrl.size() <= 2048
        && (p.coverUrl == '' || p.coverUrl.matches('https://.*'))
        && p.youtubeUrl is string && p.youtubeUrl.size() <= 2048
        && p.status in ['draft','published'] && p.authorId is string
        && p.createdAt is timestamp && p.updatedAt == request.time;
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create: if isAdmin() && validPost(request.resource.data)
        && request.resource.data.authorId == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validPost(request.resource.data)
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }
  }
}
